

    Pulled all HD6000 + HD6000c TDM modules not currently on firmware 169044P10702001. Result: 3,249 modules. For context, 8,150 are already on target (11,398 total active HD6000-family TDM modules). HD6000c is included, filter the module_model column if HD6000-only is wanted. Note: “under this version” interpreted as “not on target build”, flag if a numeric-version cutoff was intended.



SELECT
    SUM(CASE WHEN firmware_version =  '169044P10702001' THEN 1 ELSE 0 END) AS on_target,
    SUM(CASE WHEN firmware_version <> '169044P10702001' THEN 1 ELSE 0 END) AS off_target,
    SUM(CASE WHEN firmware_version IS NULL THEN 1 ELSE 0 END)              AS null_fw
FROM LifecycleServicesReporting.dbo.truck_firmware_tracker
WHERE module_model IN ('HD6000','HD6000c')
  AND device_name = 'TDM'
  AND current_flag = 1
  AND deleted_flag != 1;


SELECT COUNT(*) AS active_rows_before_dedupe
FROM LifecycleServicesReporting.dbo.truck_firmware_tracker
WHERE module_model IN ('HD6000','HD6000c')
  AND device_name = 'TDM'
  AND current_flag = 1
  AND deleted_flag != 1;


SELECT DISTINCT firmware_version, LEN(firmware_version) AS len
FROM LifecycleServicesReporting.dbo.truck_firmware_tracker
WHERE module_model IN ('HD6000','HD6000c')
  AND device_name = 'TDM'
  AND firmware_version LIKE '%169044P10702001%';


