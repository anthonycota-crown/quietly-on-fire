# ContextOS server environment variables
# Copy this file to server/.env and fill in values you need.
#
# v4+: LLM provider and API keys are configured at runtime via Settings → LLM
# and stored in server/data/config.json. The env vars below are FALLBACKS only.

# Fallback Anthropic API key (used only if no key is saved in Settings)
ANTHROPIC_API_KEY=

# Auth token for API access (leave empty to disable — localhost always bypasses)
AUTH_TOKEN=

# Port the server listens on (default: 3001)
PORT=3001

# Optional: OpenAI API key fallback (or configure in Settings → LLM)
OPENAI_API_KEY=

# Optional: allowed CORS origins beyond localhost (comma-separated)
ALLOWED_ORIGINS=

# Optional: parallel Studio → library fast-path workers (1–8, default: 2)
# The deep AI enrichment queue is independently bounded.
STUDIO_HANDOFF_CONCURRENCY=8

# Optional: bounded parallel workers for Optimize context.
# Census workers process separate document batches; model workers deepen the
# highest-impact documents. Keep both within the provider account's rate limit.
REFINE_CENSUS_CONCURRENCY=4
REFINE_MODEL_CONCURRENCY=4
REFINE_CENSUS_ATTEMPTS=3
REFINE_CHAPTER_CONCURRENCY=6
REFINE_CHAPTER_ATTEMPTS=4
# Keep CPU-heavy concept compression and ENCODE map construction off the API
# event loop so status, Stop, chat, and browsing remain responsive.
REFINE_GRAPH_WORKER=1
REFINE_GRAPH_TIMEOUT_MS=900000

# Optional: Web Push VAPID keys for push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
